<!DOCTYPE html>
<html lang="en">
  <head>
    <title>Agentic Pet Shop</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="A small pet shop for testing agents: catalogue, cart and checkout, with WebMCP tools.">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="icon" href="/icon.png" type="image/png">
    <%= csrf_meta_tags %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body>
    <header>
      <a href="<%= root_path %>" class="brand">Agentic Pet Shop</a>
      <a href="<%= cart_path %>" id="cart-link">Cart (<span id="cart-count"><%= current_cart.item_count %></span>)</a>
    </header>
    <% flash.each do |kind, message| %>
      <p class="flash flash-<%= kind %>" role="status"><%= message %></p>
    <% end %>
    <main><%= yield %></main>
    <footer id="build" hidden></footer>
    <script type="module">
      // dev build line: sha, branch, slot (the endpoint answers 204 outside dev)
      fetch("/api/build").then((r) => (r.status === 200 ? r.json() : null)).then((b) => {
        if (!b) return;
        const el = document.getElementById("build");
        el.textContent = [b.sha + (b.dirty ? " (dirty)" : ""), b.branch,
          b.slot === null ? "main :" + b.port : "slot " + b.slot + " :" + b.port].join(" · ");
        el.hidden = false;
      }).catch(() => {});
    </script>
  </body>
</html>
