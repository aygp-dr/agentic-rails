<h1><%= @pet.name %></h1>
<p><%= @pet.species %> · <span class="price"><%= @pet.price %></span> ·
   <span class="stock"><%= @pet.in_stock? ? "#{@pet.stock} in stock" : "sold out" %></span></p>
<%= button_to "Add to cart", cart_items_path, params: { sku: @pet.sku }, disabled: !@pet.in_stock?, class: "add" %>
<p><a href="<%= root_path %>">All pets</a></p>
